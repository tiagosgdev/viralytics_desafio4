<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/connection_help"
        android:textColor="@color/brand_muted"
        android:textSize="13sp" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:boxBackgroundColor="@color/brand_surface_soft"
        app:boxCornerRadiusBottomEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusTopStart="16dp"
        app:boxStrokeColor="@color/brand_border"
        app:hintTextColor="@color/brand_muted">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/dialogServerUrlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/server_url_hint"
            android:inputType="textUri"
            android:textColor="@color/brand_text"
            android:textColorHint="@color/brand_muted" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="DEVICE MODE (testing override)"
        android:textColor="@color/brand_muted"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.10" />

    <RadioGroup
        android:id="@+id/deviceModeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <RadioButton
            android:id="@+id/modePhoneRadio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phone / Camera — takes photos, sends to tablet"
            android:textColor="@color/brand_text"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/modeTabletRadio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Tablet / Display — shows results from phone"
            android:textColor="@color/brand_text"
            android:textSize="13sp" />
    </RadioGroup>
</LinearLayout>
