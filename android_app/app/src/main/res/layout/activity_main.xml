<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mobile_app_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/content_padding">

        <!-- ── HEADER ─────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Brand mark badge -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/mobile_brand_mark">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_checkroom"
                    app:tint="@color/brand_accent" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="@string/app_name"
                    android:textColor="@color/brand_text"
                    android:textSize="@dimen/header_title_size"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:tag="color_accent"
                    android:text="@string/brand_kicker"
                    android:textColor="@color/brand_accent"
                    android:textSize="@dimen/section_label_size"
                    android:letterSpacing="0.18" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/connectionSettingsButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/mobile_icon_button"
                android:contentDescription="@string/connection_settings"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_manage"
                android:tint="@color/brand_text" />
        </LinearLayout>

        <!-- Status pill on its own row so it never squishes the title -->
        <LinearLayout
            android:id="@+id/statusPill"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:background="@drawable/mobile_status_pill"
            android:paddingStart="10dp"
            android:paddingEnd="14dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/mobile_status_dot" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Ready"
                android:textColor="@color/brand_text"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Persona chip + switch button -->
        <LinearLayout
            android:id="@+id/personaRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/personaChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/mobile_persona_chip"
                android:fontFamily="monospace"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:letterSpacing="0.10"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/switchPersonaButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/switch_stylist"
                android:textColor="@color/brand_muted"
                android:textSize="11sp"
                app:rippleColor="@color/brand_surface_soft" />
        </LinearLayout>

        <!-- Session label -->
        <TextView
            android:id="@+id/sessionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/session_waiting"
            android:textColor="@color/brand_muted"
            android:textSize="11sp" />

        <!-- Mode indicator -->
        <TextView
            android:id="@+id/modeIndicatorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/mobile_status_pill"
            android:fontFamily="monospace"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textColor="@color/brand_muted"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.10" />

        <!-- ── TAB BAR ──────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/tabBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/mobile_tab_bar_bg"
            android:padding="5dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabScanButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/tab_button_height"
                android:layout_weight="1"
                android:text="@string/tab_scan"
                android:textSize="13sp"
                android:textColor="@color/white"
                app:icon="@drawable/ic_camera"
                app:iconGravity="start"
                app:iconSize="16dp"
                app:backgroundTint="@color/brand_accent"
                app:cornerRadius="999dp"
                app:elevation="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabRefineButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/tab_button_height"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/tab_refine"
                android:textSize="13sp"
                android:textColor="@color/brand_text"
                app:icon="@drawable/ic_chat"
                app:iconGravity="start"
                app:iconSize="16dp"
                app:cornerRadius="999dp"
                app:strokeColor="@color/brand_border" />
        </LinearLayout>

        <!-- ── SCAN SECTION ────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/scanSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Customer profile card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/customerProfileCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/brand_surface"
                app:cardCornerRadius="@dimen/card_corner"
                app:cardElevation="0dp"
                app:strokeColor="@color/brand_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:tag="color_muted"
                        android:text="CUSTOMER PROFILE"
                        android:textColor="@color/brand_muted"
                        android:textSize="@dimen/section_label_size"
                        android:textStyle="bold"
                        android:letterSpacing="0.16" />

                    <!-- Gender row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Gender"
                            android:textColor="@color/brand_text"
                            android:textSize="13sp" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/genderChipGroup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:singleSelection="true"
                            app:chipSpacingHorizontal="4dp">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipMale"
                                style="@style/Widget.MaterialComponents.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checkable="true"
                                android:text="Male"
                                android:textSize="12sp" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipFemale"
                                style="@style/Widget.MaterialComponents.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checkable="true"
                                android:text="Female"
                                android:textSize="12sp" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipOther"
                                style="@style/Widget.MaterialComponents.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checkable="true"
                                android:text="Other"
                                android:textSize="12sp" />

                        </com.google.android.material.chip.ChipGroup>
                    </LinearLayout>

                    <!-- Height row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Height (cm)"
                            android:textColor="@color/brand_text"
                            android:textSize="13sp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/heightInputLayout"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            app:boxBackgroundColor="@color/brand_surface_soft"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxStrokeColor="@color/brand_border"
                            app:hintTextColor="@color/brand_muted">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/heightInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="e.g. 170"
                                android:inputType="number"
                                android:maxLength="3"
                                android:textColor="@color/brand_text"
                                android:textColorHint="@color/brand_muted"
                                android:textSize="14sp" />

                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Scan controls card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/brand_surface"
                app:cardCornerRadius="@dimen/card_corner"
                app:cardElevation="0dp"
                app:strokeColor="@color/brand_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:tag="color_muted"
                        android:text="SCAN CONTROLS"
                        android:textColor="@color/brand_muted"
                        android:textSize="@dimen/section_label_size"
                        android:textStyle="bold"
                        android:letterSpacing="0.16" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/scan_help"
                        android:textColor="@color/brand_text"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/captureButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:minHeight="@dimen/capture_button_min_height"
                        android:text="@string/capture_outfit"
                        android:textColor="@color/white"
                        app:icon="@drawable/ic_camera"
                        app:iconGravity="start"
                        app:iconSize="18dp"
                        app:backgroundTint="@color/brand_accent"
                        app:cornerRadius="999dp" />

                    <!-- Camera stage -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/scan_image_height"
                        android:layout_marginTop="12dp">

                        <ImageView
                            android:id="@+id/resultImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:adjustViewBounds="true"
                            android:background="@drawable/mobile_camera_surface"
                            android:contentDescription="@string/annotated_scan"
                            android:scaleType="fitCenter" />

                        <!-- Camera-stage decorations (hidden once a scan image is shown) -->
                        <FrameLayout
                            android:id="@+id/cameraStageDecor"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <View
                                android:id="@+id/scanOval"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:layout_marginStart="42dp"
                                android:layout_marginEnd="42dp"
                                android:layout_marginTop="12dp"
                                android:layout_marginBottom="12dp"
                                android:background="@drawable/mobile_scan_oval" />

                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_gravity="top|start"
                                android:layout_margin="10dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_corner_bracket" />

                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_gravity="bottom|end"
                                android:layout_margin="10dp"
                                android:contentDescription="@null"
                                android:rotation="180"
                                android:src="@drawable/ic_corner_bracket" />

                            <View
                                android:id="@+id/scanLine"
                                android:layout_width="match_parent"
                                android:layout_height="2dp"
                                android:layout_gravity="top"
                                android:layout_marginStart="14dp"
                                android:layout_marginEnd="14dp"
                                android:background="@drawable/mobile_scan_line" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginStart="54dp"
                                android:layout_marginEnd="54dp"
                                android:layout_marginTop="24dp"
                                android:layout_marginBottom="24dp"
                                android:gravity="center"
                                android:orientation="vertical">

                                <ImageView
                                    android:layout_width="@dimen/camera_stage_icon_size"
                                    android:layout_height="@dimen/camera_stage_icon_size"
                                    android:contentDescription="@string/camera_stage_title"
                                    android:src="@drawable/ic_accessibility" />

                                <TextView
                                    android:id="@+id/cameraStageTitleText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:fontFamily="serif"
                                    android:gravity="center"
                                    android:text="@string/camera_stage_title"
                                    android:textColor="@color/brand_text"
                                    android:textSize="@dimen/camera_stage_title_size" />

                                <TextView
                                    android:id="@+id/cameraStageHintText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:gravity="center"
                                    android:tag="color_muted"
                                    android:text="@string/camera_stage_hint"
                                    android:textColor="@color/brand_muted"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </FrameLayout>

                        <!-- Live preview status chip -->
                        <LinearLayout
                            android:id="@+id/cameraStatusChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|start"
                            android:layout_margin="12dp"
                            android:background="@android:color/transparent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="9dp"
                            android:paddingEnd="11dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp">

                            <View
                                android:id="@+id/liveDot"
                                android:layout_width="7dp"
                                android:layout_height="7dp"
                                android:background="@drawable/mobile_status_dot" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:fontFamily="monospace"
                                android:text="@string/live_preview"
                                android:textColor="@color/brand_text"
                                android:textSize="9sp"
                                android:letterSpacing="0.12" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/bodyShapeLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|end"
                            android:layout_margin="12dp"
                            android:background="@drawable/mobile_body_shape_bg"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                    </FrameLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Detected clothing card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/detectedClothingCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/brand_surface"
                app:cardCornerRadius="@dimen/card_corner"
                app:cardElevation="0dp"
                app:strokeColor="@color/brand_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:tag="color_muted"
                        android:text="DETECTED CLOTHING"
                        android:textColor="@color/brand_muted"
                        android:textSize="@dimen/section_label_size"
                        android:textStyle="bold"
                        android:letterSpacing="0.16" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/detectionsGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="6dp"
                        app:singleLine="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ── RECOMMENDATIONS ─────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/recommendationsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/brand_surface"
                app:cardCornerRadius="@dimen/card_corner"
                app:cardElevation="0dp"
                app:strokeColor="@color/brand_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:tag="color_muted"
                            android:text="STORE RECOMMENDATIONS"
                            android:textColor="@color/brand_muted"
                            android:textSize="@dimen/section_label_size"
                            android:textStyle="bold"
                            android:letterSpacing="0.16" />

                        <ImageButton
                            android:id="@+id/recommendationsLeftButton"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/mobile_icon_button"
                            android:contentDescription="@string/recommendations_left"
                            android:padding="8dp"
                            android:src="@android:drawable/ic_media_previous"
                            android:tint="@color/brand_text" />

                        <ImageButton
                            android:id="@+id/recommendationsRightButton"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/mobile_icon_button"
                            android:contentDescription="@string/recommendations_right"
                            android:padding="8dp"
                            android:src="@android:drawable/ic_media_next"
                            android:tint="@color/brand_text" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:id="@+id/recommendationsScroll"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/rec_scroll_height"
                        android:layout_marginTop="10dp"
                        android:fillViewport="true"
                        android:overScrollMode="never"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/recommendationsStrip"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <TextView
                        android:id="@+id/recommendationsEmptyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/mobile_empty_state"
                        android:gravity="center"
                        android:padding="16dp"
                        android:text="@string/recommendations_empty"
                        android:textColor="@color/brand_muted" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ── REFINE / CHAT SECTION ───────────────────────────────── -->
        <LinearLayout
            android:id="@+id/refineSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/brand_surface"
                app:cardCornerRadius="@dimen/card_corner"
                app:cardElevation="0dp"
                app:strokeColor="@color/brand_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:tag="color_muted"
                        android:text="STYLIST CHAT"
                        android:textColor="@color/brand_muted"
                        android:textSize="@dimen/section_label_size"
                        android:textStyle="bold"
                        android:letterSpacing="0.16" />

                    <!-- Chat message thread -->
                    <ScrollView
                        android:id="@+id/chatThreadScroll"
                        android:layout_width="match_parent"
                        android:layout_height="240dp"
                        android:layout_marginTop="12dp"
                        android:fillViewport="true"
                        android:overScrollMode="never"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/chatThreadContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </ScrollView>

                    <!-- Typing indicator (hidden by default) -->
                    <LinearLayout
                        android:id="@+id/chatTypingRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/mobile_chat_bubble_bot"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/typingDots"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="•  ·  ·"
                            android:textColor="@color/brand_muted"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Retained system reply line (hidden; thread is primary) -->
                    <TextView
                        android:id="@+id/chatReplyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/mobile_reply_surface"
                        android:padding="14dp"
                        android:text="@string/chat_empty"
                        android:textColor="@color/brand_text"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <Switch
                        android:id="@+id/replaceVisionSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/replace_vision"
                        android:textColor="@color/brand_text" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/chatInputLayout"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:boxBackgroundColor="@color/brand_surface_soft"
                            app:boxCornerRadiusBottomEnd="999dp"
                            app:boxCornerRadiusBottomStart="999dp"
                            app:boxCornerRadiusTopEnd="999dp"
                            app:boxCornerRadiusTopStart="999dp"
                            app:boxStrokeColor="@color/brand_border"
                            app:hintTextColor="@color/brand_muted">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/chatInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/chat_input_hint"
                                android:inputType="text"
                                android:maxLines="1"
                                android:imeOptions="actionSend"
                                android:textColor="@color/brand_text"
                                android:textColorHint="@color/brand_muted" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <ImageButton
                            android:id="@+id/sendChatButton"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/mobile_send_button"
                            android:contentDescription="@string/send_refinement"
                            android:padding="14dp"
                            android:src="@drawable/ic_send"
                            android:tint="@color/white" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
