<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ── HEADER ─────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Logo: "FashionSense  OUTFIT SCANNER" inline -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/brand_text"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="serif" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:tag="color_accent"
                    android:text="OUTFIT SCANNER"
                    android:textColor="@color/brand_accent"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10" />
            </LinearLayout>

            <!-- Status pill: dot + label -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:background="@drawable/mobile_status_pill"
                android:paddingStart="10dp"
                android:paddingEnd="14dp"
                android:layout_marginEnd="8dp">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/mobile_status_dot" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Ready"
                    android:textColor="@color/brand_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/connectionSettingsButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/mobile_icon_button"
                android:contentDescription="@string/connection_settings"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_manage"
                android:tint="@color/brand_text" />
        </LinearLayout>

        <!-- Persona chip + switch button (hidden until persona chosen) -->
        <LinearLayout
            android:id="@+id/personaRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/personaChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/mobile_persona_chip"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/switchPersonaButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/switch_stylist"
                android:textColor="@color/brand_muted"
                android:textSize="11sp"
                app:rippleColor="@color/brand_surface_soft" />
        </LinearLayout>

        <!-- Session label -->
        <TextView
            android:id="@+id/sessionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/session_waiting"
            android:textColor="@color/brand_muted"
            android:textSize="11sp" />

        <!-- Mode indicator (shows CAMERA MODE / DISPLAY MODE) -->
        <TextView
            android:id="@+id/modeIndicatorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/mobile_status_pill"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textColor="@color/brand_muted"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <!-- ── TAB BAR ──────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/tabBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/mobile_tab_bar_bg"
            android:padding="4dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabScanButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/tab_scan"
                android:textSize="13sp"
                android:textColor="@color/white"
                app:icon="@drawable/ic_camera"
                app:iconGravity="start"
                app:iconSize="16dp"
                app:backgroundTint="@color/brand_text"
                app:cornerRadius="14dp"
                app:elevation="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabRefineButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/tab_refine"
                android:textSize="13sp"
                android:textColor="@color/brand_text"
                app:icon="@drawable/ic_chat"
                app:iconGravity="start"
                app:iconSize="16dp"
                app:cornerRadius="14dp"
                app:strokeColor="@color/brand_border" />
        </LinearLayout>

        <!-- ── SCAN SECTION ────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/scanSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Scan controls card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/brand_surface"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/brand_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:tag="color_muted"
                        android:text="SCAN CONTROLS"
                        android:textColor="@color/brand_muted"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/scan_help"
                        android:textColor="@color/brand_text"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/captureButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:minHeight="50dp"
                        android:text="@string/capture_outfit"
                        android:textColor="@color/white"
                        app:icon="@drawable/ic_camera"
                        app:iconGravity="start"
                        app:iconSize="18dp"
                        app:backgroundTint="@color/brand_text"
                        app:cornerRadius="16dp" />

                    <TextView
                        android:id="@+id/scanWaitingText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/mobile_empty_state"
                        android:gravity="center"
                        android:padding="18dp"
                        android:text="Waiting for scan from phone…"
                        android:textColor="@color/brand_muted"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/resultImage"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginTop="14dp"
                        android:adjustViewBounds="true"
                        android:background="@drawable/mobile_camera_surface"
                        android:contentDescription="@string/annotated_scan"
                        android:scaleType="fitCenter" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Detected clothing card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/brand_surface"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/brand_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:tag="color_muted"
                        android:text="DETECTED CLOTHING"
                        android:textColor="@color/brand_muted"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/detectionsGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="8dp"
                        app:singleLine="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ── RECOMMENDATIONS (shown in both tabs) ────────────────── -->
        <LinearLayout
            android:id="@+id/recommendationsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/brand_surface"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/brand_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:tag="color_muted"
                            android:text="STORE RECOMMENDATIONS"
                            android:textColor="@color/brand_muted"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.12" />

                        <ImageButton
                            android:id="@+id/recommendationsLeftButton"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/mobile_icon_button"
                            android:contentDescription="@string/recommendations_left"
                            android:padding="8dp"
                            android:src="@android:drawable/ic_media_previous"
                            android:tint="@color/brand_text" />

                        <ImageButton
                            android:id="@+id/recommendationsRightButton"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/mobile_icon_button"
                            android:contentDescription="@string/recommendations_right"
                            android:padding="8dp"
                            android:src="@android:drawable/ic_media_next"
                            android:tint="@color/brand_text" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:id="@+id/recommendationsScroll"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginTop="12dp"
                        android:fillViewport="true"
                        android:overScrollMode="never"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/recommendationsStrip"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <TextView
                        android:id="@+id/recommendationsEmptyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/mobile_empty_state"
                        android:gravity="center"
                        android:padding="18dp"
                        android:text="@string/recommendations_empty"
                        android:textColor="@color/brand_muted" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ── REFINE / CHAT SECTION ───────────────────────────────── -->
        <LinearLayout
            android:id="@+id/refineSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/brand_surface"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/brand_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:tag="color_muted"
                        android:text="REFINE SEARCH"
                        android:textColor="@color/brand_muted"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12" />

                    <!-- Welcome state (chat-welcome) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingTop="16dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chat_welcome_title"
                            android:textColor="@color/brand_text"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:tag="color_muted"
                            android:text="@string/chat_welcome_sub"
                            android:textColor="@color/brand_muted"
                            android:textSize="12sp"
                            android:gravity="center" />
                    </LinearLayout>

                    <!-- Assistant reply bubble -->
                    <TextView
                        android:id="@+id/chatReplyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/mobile_reply_surface"
                        android:padding="14dp"
                        android:text="@string/chat_empty"
                        android:textColor="@color/brand_text"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <Switch
                        android:id="@+id/replaceVisionSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/replace_vision"
                        android:textColor="@color/brand_text" />

                    <!-- Chat input bar: text field + send button side by side -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/chatInputLayout"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:boxBackgroundColor="@color/brand_surface_soft"
                            app:boxCornerRadiusBottomEnd="16dp"
                            app:boxCornerRadiusBottomStart="16dp"
                            app:boxCornerRadiusTopEnd="16dp"
                            app:boxCornerRadiusTopStart="16dp"
                            app:boxStrokeColor="@color/brand_border"
                            app:hintTextColor="@color/brand_muted">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/chatInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/chat_input_hint"
                                android:inputType="text"
                                android:maxLines="1"
                                android:imeOptions="actionSend"
                                android:textColor="@color/brand_text"
                                android:textColorHint="@color/brand_muted" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <ImageButton
                            android:id="@+id/sendChatButton"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/mobile_send_button"
                            android:contentDescription="@string/send_refinement"
                            android:padding="14dp"
                            android:src="@drawable/ic_send"
                            android:tint="@color/white" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
